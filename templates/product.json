          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bd-stock-alert\">\n  <div class=\"bd-stock-title\">\n    <span class=\"bd-fire bd-fire-left\">🔥</span>\n\n    <span class=\"bd-heading\">\n      Limited Stock — Selling Fast!\n    </span>\n\n    <span class=\"bd-fire bd-fire-right\">🔥</span>\n  </div>\n\n  <div class=\"bd-stock-subtitle\">\n    Order Yours Now Before It’s Gone\n  </div>\n</div>\n\n<style>\n\n.bd-stock-alert {\n  width: 100%;\n  box-sizing: border-box;\n\n  margin: 12px 0 20px;\n  padding: 16px 15px;\n\n  background: linear-gradient(\n    135deg,\n    #431684 0%,\n    #6524d4 100%\n  );\n\n  border: 2px solid #F2D400;\n  border-radius: 18px;\n\n  text-align: center;\n\n  box-shadow:\n    0 7px 18px rgba(0, 0, 0, 0.20);\n\n  transform-origin: center;\n\n  animation: bdHeartbeat 1.35s infinite ease-in-out;\n}\n\n\n/* TITLE */\n\n.bd-stock-title {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  flex-wrap: wrap;\n\n  gap: 9px;\n\n  color: #ffffff;\n\n  font-size: 20px;\n  font-weight: 800;\n\n  line-height: 1.3;\n}\n\n\n.bd-heading {\n  display: inline-block;\n}\n\n\n/* FIRE */\n\n.bd-fire {\n  display: inline-block;\n\n  font-size: 25px;\n\n  animation:\n    bdFireBlink 0.70s infinite ease-in-out,\n    bdFirePulse 0.70s infinite ease-in-out;\n}\n\n\n/* Slight delay on right fire */\n\n.bd-fire-right {\n  animation-delay: 0.35s;\n}\n\n\n/* SUBTITLE */\n\n.bd-stock-subtitle {\n  margin-top: 7px;\n\n  color: #ffffff;\n\n  font-size: 14px;\n  font-weight: 500;\n\n  opacity: 0.95;\n}\n\n\n/* =========================\n   HEARTBEAT BOX ANIMATION\n========================= */\n\n@keyframes bdHeartbeat {\n\n  0% {\n    transform: scale(1);\n  }\n\n  10% {\n    transform: scale(1.025);\n  }\n\n  20% {\n    transform: scale(1);\n  }\n\n  30% {\n    transform: scale(1.04);\n  }\n\n  42% {\n    transform: scale(1);\n  }\n\n  100% {\n    transform: scale(1);\n  }\n}\n\n\n/* FIRE BLINK */\n\n@keyframes bdFireBlink {\n\n  0%,\n  100% {\n    opacity: 1;\n  }\n\n  50% {\n    opacity: 0.25;\n  }\n}\n\n\n/* FIRE PULSE */\n\n@keyframes bdFirePulse {\n\n  0%,\n  100% {\n    transform: scale(1);\n  }\n\n  50% {\n    transform: scale(1.35);\n  }\n}\n\n\n/* MOBILE */\n\n@media screen and (max-width: 749px) {\n\n  .bd-stock-alert {\n    padding: 14px 10px;\n    margin: 10px 0 17px;\n\n    border-radius: 15px;\n\n    animation-duration: 1.45s;\n  }\n\n  .bd-stock-title {\n    font-size: 16px;\n    gap: 6px;\n  }\n\n  .bd-fire {\n    font-size: 21px;\n  }\n\n  .bd-stock-subtitle {\n    margin-top: 5px;\n    font-size: 12px;\n  }\n\n}\n\n</style>"
