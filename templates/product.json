      "settings": {
        "custom_liquid": "{% comment %}\n  Bestdeal.pk Animated Waves - paste this into a Shopify \"Custom liquid\" section.\n  This is intentionally separate from the footer.\n{% endcomment %}\n\n<style>\n  .bestdeal-custom-waves {\n    --wave-purple: #6F2ED6;\n    --wave-gold: #9A6A35;\n    --wave-soft: #8D5B9A;\n    position: relative;\n    width: 100%;\n    height: 130px;\n    overflow: hidden;\n    background: transparent;\n    line-height: 0;\n    pointer-events: none;\n  }\n\n  .bestdeal-custom-waves .bdcw-wave {\n    position: absolute;\n    left: -3%;\n    bottom: 0;\n    width: 106%;\n    height: 100%;\n    transform-origin: center bottom;\n    will-change: transform;\n  }\n\n  .bestdeal-custom-waves .bdcw-wave--1 {\n    opacity: .72;\n    animation: bdcwWave1 5s ease-in-out infinite;\n  }\n\n  .bestdeal-custom-waves .bdcw-wave--2 {\n    opacity: .50;\n    animation: bdcwWave2 7s ease-in-out infinite;\n  }\n\n  .bestdeal-custom-waves .bdcw-wave--3 {\n    opacity: .30;\n    animation: bdcwWave3 9s ease-in-out infinite;\n  }\n\n  @keyframes bdcwWave1 {\n    0%,100% { transform: translate3d(-1.2%,0,0) scaleX(1.02); }\n    50% { transform: translate3d(1.3%,7px,0) scaleX(1.05); }\n  }\n\n  @keyframes bdcwWave2 {\n    0%,100% { transform: translate3d(1%,4px,0) scaleX(1.05); }\n    50% { transform: translate3d(-1.6%,-5px,0) scaleX(1.01); }\n  }\n\n  @keyframes bdcwWave3 {\n    0%,100% { transform: translate3d(-.8%,-2px,0) scaleX(1.01); }\n    50% { transform: translate3d(1.8%,9px,0) scaleX(1.06); }\n  }\n\n  @media screen and (max-width: 749px) {\n    .bestdeal-custom-waves {\n      height: 90px;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .bestdeal-custom-waves .bdcw-wave {\n      animation: none !important;\n    }\n  }\n</style>\n\n<div class=\"bestdeal-custom-waves\" aria-hidden=\"true\">\n  <svg class=\"bdcw-wave bdcw-wave--1\" viewBox=\"0 0 1440 180\" preserveAspectRatio=\"none\">\n    <path fill=\"var(--wave-purple)\" d=\"M-20 98 C 170 40, 350 145, 565 91 S 935 29, 1175 86 S 1415 132, 1490 72 L 1490 200 L -20 200 Z\"/>\n  </svg>\n\n  <svg class=\"bdcw-wave bdcw-wave--2\" viewBox=\"0 0 1440 180\" preserveAspectRatio=\"none\">\n    <path fill=\"var(--wave-gold)\" d=\"M-35 120 C 175 151, 350 45, 565 111 S 910 154, 1125 77 S 1385 35, 1490 93 L 1490 200 L -35 200 Z\"/>\n  </svg>\n\n  <svg class=\"bdcw-wave bdcw-wave--3\" viewBox=\"0 0 1440 180\" preserveAspectRatio=\"none\">\n    <path fill=\"var(--wave-soft)\" d=\"M-25 94 C 180 155, 370 74, 610 118 S 930 150, 1120 92 S 1360 70, 1490 118 L 1490 200 L -25 200 Z\"/>\n  </svg>\n</div>",
