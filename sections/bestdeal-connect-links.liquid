          }
        },
        {
          "type": "social_link",
          "settings": {
            "title": "YouTube",
            "button_color": "#5A22A5",
            "text_color": "#FFFFFF"
          }
        },
        {
          "type": "social_link",
          "settings": {
            "title": "Read Our Blog",
            "button_color": "#FFD35C",
            "text_color": "#32114F"
          }
        }
      ]
    }
  ]
}
{% endschema %}