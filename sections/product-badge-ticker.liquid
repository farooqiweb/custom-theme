{% comment %}
  Moving Trust Badges / Infinite Marquee
  Section file: moving-trust-badges.liquid
{% endcomment %}

{% liquid
  assign section_id = 'trust-marquee-' | append: section.id
%}

<section
  id="{{ section_id }}"
  class="trust-marquee-section"
  style="
    --tm-bg: {{ section.settings.background_color }};
    --tm-title-color: {{ section.settings.heading_color }};
    --tm-text-color: {{ section.settings.text_color }};
    --tm-gap: {{ section.settings.desktop_gap }}px;
    --tm-image-size: {{ section.settings.desktop_image_size }}px;
    --tm-title-size: {{ section.settings.desktop_title_size }}px;
    --tm-heading-size: {{ section.settings.desktop_heading_size }}px;
    --tm-speed: {{ section.settings.animation_speed }}s;
    --tm-padding-top: {{ section.settings.padding_top }}px;
    --tm-padding-bottom: {{ section.settings.padding_bottom }}px;
    --tm-mobile-gap: {{ section.settings.mobile_gap }}px;
    --tm-mobile-image-size: {{ section.settings.mobile_image_size }}px;
    --tm-mobile-title-size: {{ section.settings.mobile_title_size }}px;
    --tm-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
  "
>
  <div class="trust-marquee-inner">

    {% if section.settings.heading != blank %}
      <h2 class="trust-marquee-heading">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div
        class="trust-marquee-window"
        {% if section.settings.pause_on_hover %}
          data-pause-hover="true"
        {% endif %}
      >
        <div
          class="
            trust-marquee-track
            {% if section.settings.direction == 'right' %}
              trust-marquee-track--right
            {% endif %}
          "
        >

          <!-- First copy -->
          <div class="trust-marquee-group">
            {% for block in section.blocks %}
              <div
                class="trust-marquee-item"
                {{ block.shopify_attributes }}
              >
                {% if block.settings.badge_image != blank %}
                  <div class="trust-marquee-image-wrap">
                    {{
                      block.settings.badge_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '80, 120, 160, 200, 300, 400',
                        class: 'trust-marquee-image',
                        alt: block.settings.badge_title
                    }}
                  </div>
                {% else %}
                  <div class="trust-marquee-placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if block.settings.badge_title != blank %}
                  <div class="trust-marquee-title">
                    {{ block.settings.badge_title }}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

          <!-- Duplicate copy for seamless looping -->
          <div
            class="trust-marquee-group"
            aria-hidden="true"
          >
            {% for block in section.blocks %}
              <div class="trust-marquee-item">

                {% if block.settings.badge_image != blank %}
                  <div class="trust-marquee-image-wrap">
                    {{
                      block.settings.badge_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '80, 120, 160, 200, 300, 400',
                        class: 'trust-marquee-image',
                        alt: ''
                    }}
                  </div>
                {% else %}
                  <div class="trust-marquee-placeholder">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}

                {% if block.settings.badge_title != blank %}
                  <div class="trust-marquee-title">
                    {{ block.settings.badge_title }}
                  </div>
                {% endif %}
              </div>
            {% endfor %}
          </div>

        </div>
      </div>
    {% else %}
      <div class="trust-marquee-empty">
        Add Trust Badge blocks from the Theme Customizer.
      </div>
    {% endif %}

  </div>
</section>

<style>
  #{{ section_id }} {
    background: var(--tm-bg);
    padding-top: var(--tm-padding-top);
    padding-bottom: var(--tm-padding-bottom);
    width: 100%;
    overflow: hidden;
  }

  #{{ section_id }} .trust-marquee-inner {
    width: 100%;
  }

  #{{ section_id }} .trust-marquee-heading {
    margin: 0 20px 28px;
    padding: 0;
    text-align: {{ section.settings.heading_alignment }};
    color: var(--tm-title-color);
    font-size: var(--tm-heading-size);
    line-height: 1.2;
    font-weight: {{ section.settings.heading_weight }};
  }

  #{{ section_id }} .trust-marquee-window {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  #{{ section_id }} .trust-marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation:
      trustMarqueeLeft-{{ section.id }}
      var(--tm-speed)
      linear
      infinite;
  }

  #{{ section_id }} .trust-marquee-track--right {
    animation-name: trustMarqueeRight-{{ section.id }};
  }

  #{{ section_id }} .trust-marquee-group {
    display: flex;
    align-items: center;
    gap: var(--tm-gap);
    flex-shrink: 0;
    padding-right: var(--tm-gap);
  }

  #{{ section_id }} .trust-marquee-item {
    flex: 0 0 auto;
    min-width: max-content;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ section.settings.image_text_gap }}px;
  }

  #{{ section_id }} .trust-marquee-image-wrap {
    width: var(--tm-image-size);
    height: var(--tm-image-size);
    flex: 0 0 var(--tm-image-size);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #{{ section_id }} .trust-marquee-image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: {{ section.settings.image_fit }};
  }

  #{{ section_id }} .trust-marquee-placeholder {
    width: var(--tm-image-size);
    height: var(--tm-image-size);
    flex: 0 0 var(--tm-image-size);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #{{ section_id }} .trust-marquee-placeholder svg {
    width: 100%;
    height: 100%;
  }

  #{{ section_id }} .trust-marquee-title {
    color: var(--tm-text-color);
    font-size: var(--tm-title-size);
    font-weight: {{ section.settings.badge_title_weight }};
    line-height: 1.25;
    white-space: nowrap;
  }

  #{{ section_id }} .trust-marquee-empty {
    padding: 20px;
    text-align: center;
    color: var(--tm-text-color);
  }

  {% if section.settings.pause_on_hover %}
    #{{ section_id }} .trust-marquee-window:hover .trust-marquee-track {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes trustMarqueeLeft-{{ section.id }} {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes trustMarqueeRight-{{ section.id }} {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #{{ section_id }} .trust-marquee-heading {
      margin: 0 16px 20px;
      font-size: var(--tm-mobile-heading-size);
    }

    #{{ section_id }} .trust-marquee-group {
      gap: var(--tm-mobile-gap);
      padding-right: var(--tm-mobile-gap);
    }

    #{{ section_id }} .trust-marquee-item {
      gap: {{ section.settings.mobile_image_text_gap }}px;
    }

    #{{ section_id }} .trust-marquee-image-wrap,
    #{{ section_id }} .trust-marquee-placeholder {
      width: var(--tm-mobile-image-size);
      height: var(--tm-mobile-image-size);
      flex-basis: var(--tm-mobile-image-size);
    }

    #{{ section_id }} .trust-marquee-title {
      font-size: var(--tm-mobile-title-size);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #{{ section_id }} .trust-marquee-track {
      animation-play-state: paused;
    }
  }
</style>

