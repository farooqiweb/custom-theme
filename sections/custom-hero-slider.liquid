{{ 'custom-hero-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-hero-slider.js' | asset_url }}" defer="defer"></script>

<custom-hero-slider
  class="custom-hero-slider"
  tabindex="0"
  role="region"
  aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
  aria-label="{{ 'sections.custom_hero_slider.accessibility_label' | t | escape }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-speed="{{ section.settings.autoplay_speed }}"
  data-pause-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
  data-play-label="{{ 'sections.slideshow.play_slideshow' | t | escape }}"
>
  <div class="custom-hero-slider__track" data-hero-track aria-live="polite" aria-atomic="true">
    {% for block in section.blocks %}
      {%- liquid
        assign desktop_image = block.settings.desktop_image
        assign fallback_image = 'uk-hero-kitchen.jpg'
        if forloop.index == 2
          assign fallback_image = 'uk-hero-gadgets.jpg'
        elsif forloop.index == 3
          assign fallback_image = 'uk-hero-bestsellers.jpg'
        endif
        assign mobile_image = block.settings.mobile_image
        assign slide_alt = desktop_image.alt | default: mobile_image.alt | default: block.settings.heading | default: shop.name
        assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
        assign fetch_priority = 'auto'
        if forloop.first and section.index == 1
          assign fetch_priority = 'high'
        endif
      -%}
      <div
        class="custom-hero-slider__slide"
        data-hero-slide
        {{ block.shopify_attributes }}
        role="group"
        aria-roledescription="{{ 'sections.slideshow.slide' | t }}"
        aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
      >
        {%- if desktop_image != blank -%}
          {%- assign desktop_height = desktop_image.width | divided_by: desktop_image.aspect_ratio | round -%}
          <picture class="custom-hero-slider__picture">
            {%- if mobile_image != blank -%}
              <source
                media="(max-width: 767px)"
                srcset="
                  {%- if mobile_image.width >= 375 -%}{{ mobile_image | image_url: width: 375 }} 375w,{%- endif -%}
                  {%- if mobile_image.width >= 550 -%}{{ mobile_image | image_url: width: 550 }} 550w,{%- endif -%}
                  {%- if mobile_image.width >= 750 -%}{{ mobile_image | image_url: width: 750 }} 750w,{%- endif -%}
                  {%- if mobile_image.width >= 1100 -%}{{ mobile_image | image_url: width: 1100 }} 1100w,{%- endif -%}
                  {{ mobile_image | image_url: width: 1500 }} 1500w
                "
                sizes="100vw"
              >
            {%- endif -%}
            {%- if forloop.first -%}
              {{
                desktop_image
                | image_url: width: 3840
                | image_tag:
                  class: 'custom-hero-slider__img',
                  widths: widths,
                  sizes: '100vw',
                  height: desktop_height,
                  alt: slide_alt,
                  fetchpriority: fetch_priority
              }}
            {%- else -%}
              {{
                desktop_image
                | image_url: width: 3840
                | image_tag:
                  class: 'custom-hero-slider__img',
                  widths: widths,
                  sizes: '100vw',
                  height: desktop_height,
                  alt: slide_alt,
                  loading: 'lazy'
              }}
            {%- endif -%}
          </picture>
        {%- else -%}
          <img
            class="custom-hero-slider__img"
            src="{{ fallback_image | asset_url }}"
            alt="{{ slide_alt | escape }}"
            width="1920"
            height="1080"
            {% if fetch_priority == 'high' %}
              fetchpriority="high"
            {% else %}
              loading="lazy"
            {% endif %}
          >
        {%- endif -%}

        {%- if block.settings.heading != blank or block.settings.button_label != blank -%}
          <div class="custom-hero-slider__content">
            {%- if block.settings.heading != blank -%}
              <h2 class="custom-hero-slider__title" style="color: {{ block.settings.text_color }}">
                {{ block.settings.heading | escape }}
              </h2>
            {%- endif -%}

            {%- if block.settings.button_label != blank and block.settings.banner_link != blank -%}
              <a
                href="{{ block.settings.banner_link }}"
                class="custom-hero-slider__button"
                style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
              >
                {{ block.settings.button_label | escape }}
              </a>
            {%- elsif block.settings.button_label != blank -%}
              <span
                class="custom-hero-slider__button"
                style="background-color: {{ block.settings.button_bg_color }}; color: {{ block.settings.button_text_color }};"
              >
                {{ block.settings.button_label | escape }}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {% endfor %}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="custom-hero-slider__controls">
      <button
        type="button"
        class="custom-hero-slider__nav custom-hero-slider__nav--prev"
        data-hero-prev
        aria-label="{{ 'sections.slideshow.previous_slideshow' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      <div class="custom-hero-slider__dots">
        {% for block in section.blocks %}
          <button
            type="button"
            class="custom-hero-slider__dot{% if forloop.first %} is-active{% endif %}"
            data-hero-dot="{{ forloop.index0 }}"
            aria-label="{{ 'sections.slideshow.load_slide' | t }} {{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}"
            aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
          >
            <span class="custom-hero-slider__dot-mark"></span>
          </button>
        {% endfor %}
      </div>

      <button
        type="button"
        class="custom-hero-slider__nav custom-hero-slider__nav--next"
        data-hero-next
        aria-label="{{ 'sections.slideshow.next_slideshow' | t }}"
      >
        <span class="svg-wrapper">
          {{- 'icon-caret.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.autoplay -%}
        <button
          type="button"
          class="custom-hero-slider__pause"
          data-hero-pause
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-pause.svg' | inline_asset_content -}}
          </span>
          <span class="svg-wrapper">
            {{- 'icon-play.svg' | inline_asset_content -}}
          </span>
        </button>
      {%- endif -%}
    </div>
  {%- endif -%}
</custom-hero-slider>

{% schema %}
{
  "name": "t:sections.custom_hero_slider.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.custom_hero_slider.settings.header_config.content"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.custom_hero_slider.settings.autoplay.label",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "label": "t:sections.custom_hero_slider.settings.autoplay_speed.label",
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "t:sections.custom_hero_slider.blocks.slide.name",
      "limit": 10,
      "settings": [
        {
          "type": "header",
          "content": "t:sections.custom_hero_slider.blocks.slide.settings.header_images.content"
        },
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.desktop_image.label"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.mobile_image.label"
        },
        {
          "type": "url",
          "id": "banner_link",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.banner_link.label"
        },
        {
          "type": "header",
          "content": "t:sections.custom_hero_slider.blocks.slide.settings.header_content.content"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.heading.label",
          "default": "New Arrivals"
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.text_color.label",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.button_label.label",
          "default": "Shop Now"
        },
        {
          "type": "color",
          "id": "button_bg_color",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.button_bg_color.label",
          "default": "#1C1917"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "t:sections.custom_hero_slider.blocks.slide.settings.button_text_color.label",
          "default": "#ffffff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom_hero_slider.presets.name",
      "category": "Image",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
