{% comment %}
==========================================================
VIP RESPONSIVE DEAL BANNER
Separate Desktop + Mobile Controls
==========================================================
{% endcomment %}

<section
  id="vip-deal-{{ section.id }}"
  class="vip-deal-section"
>

  <div class="vip-deal-banner">

    <div class="vip-deal-content">

      {% if section.settings.heading != blank %}
        <h2 class="vip-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.deal_badge != blank %}
        <div class="vip-deal-badge">
          {{ section.settings.deal_badge }}
        </div>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="vip-description">
          {{ section.settings.subheading }}
        </div>
      {% endif %}

      {% if section.settings.show_timer %}
        <div
          class="vip-countdown"
          data-end-date="{{ section.settings.end_date | escape }}"
        >

          <div class="vip-time-box">
            <span class="vip-days">00</span>
            <small>Days</small>
          </div>

          <div class="vip-separator">:</div>

          <div class="vip-time-box">
            <span class="vip-hours">00</span>
            <small>Hours</small>
          </div>

          <div class="vip-separator">:</div>

          <div class="vip-time-box">
            <span class="vip-minutes">00</span>
            <small>Min</small>
          </div>

          <div class="vip-separator">:</div>

          <div class="vip-time-box">
            <span class="vip-seconds">00</span>
            <small>Sec</small>
          </div>

        </div>
      {% endif %}

      {% if section.settings.button_text != blank %}
        <a
          href="{{ section.settings.button_link | default: '#' }}"
          class="vip-buy-button"
        >
          {{ section.settings.button_text }}
        </a>
      {% endif %}

    </div>

  </div>

</section>


<style>

/* ======================================================
   BASE SECTION
====================================================== */

#vip-deal-{{ section.id }} {
  width: 100%;
  box-sizing: border-box;
}


/* ======================================================
   DESKTOP
====================================================== */

@media screen and (min-width: 750px) {

  #vip-deal-{{ section.id }} {
    padding-top: {{ section.settings.desktop_section_top }}px;
    padding-bottom: {{ section.settings.desktop_section_bottom }}px;
    padding-left: 15px;
    padding-right: 15px;
  }


  #vip-deal-{{ section.id }} .vip-deal-banner {

    width: 100%;
    max-width: {{ section.settings.desktop_banner_width }}px;
    height: {{ section.settings.desktop_banner_height }}px;

    margin: 0 auto;

    position: relative;
    overflow: hidden;

    display: flex;

    background-color: {{ section.settings.banner_bg }};

    {% if section.settings.desktop_banner_image != blank %}
      background-image:
        linear-gradient(
          rgba(0,0,0,{{ section.settings.desktop_overlay | divided_by: 100.0 }}),
          rgba(0,0,0,{{ section.settings.desktop_overlay | divided_by: 100.0 }})
        ),
        url('{{ section.settings.desktop_banner_image | image_url: width: 2000 }}');
    {% endif %}

    background-size: {{ section.settings.desktop_background_size }};
    background-position: {{ section.settings.desktop_background_position }};
    background-repeat: no-repeat;

    border-radius: {{ section.settings.desktop_radius }}px;

    padding-top: {{ section.settings.desktop_padding_top }}px;
    padding-bottom: {{ section.settings.desktop_padding_bottom }}px;
    padding-left: {{ section.settings.desktop_padding_left }}px;
    padding-right: {{ section.settings.desktop_padding_right }}px;

    box-sizing: border-box;


    {% case section.settings.desktop_horizontal_position %}

      {% when 'left' %}
        justify-content: flex-start;

      {% when 'right' %}
        justify-content: flex-end;

      {% else %}
        justify-content: center;

    {% endcase %}


    {% case section.settings.desktop_vertical_position %}

      {% when 'top' %}
        align-items: flex-start;

      {% when 'bottom' %}
        align-items: flex-end;

      {% else %}
        align-items: center;

    {% endcase %}

