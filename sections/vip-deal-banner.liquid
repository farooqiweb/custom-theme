      {% else %}
        justify-content: center;

    {% endcase %}


    {% case section.settings.mobile_vertical_position %}

      {% when 'top' %}
        align-items: flex-start;

      {% when 'bottom' %}
        align-items: flex-end;

      {% else %}
        align-items: center;

    {% endcase %}

  }


  #vip-deal-{{ section.id }} .vip-deal-content {

    width: 100%;

    max-width:
      {{ section.settings.mobile_content_width }}px;

    display: flex;
    flex-direction: column;


    {% case section.settings.mobile_text_alignment %}

      {% when 'left' %}
