    padding:
      {{ section.settings.mobile_button_vertical }}px
      {{ section.settings.mobile_button_horizontal }}px;

    background:
      {{ section.settings.button_bg }};

    color:
      {{ section.settings.button_text_color }};

    text-decoration: none;

    font-size:
      {{ section.settings.mobile_button_size }}px;

    font-weight:
      {{ section.settings.button_weight }};

    border-radius:
      {{ section.settings.button_radius }}px;

    box-sizing: border-box;

  }

}


/* ======================================================
   ANIMATION
====================================================== */

@keyframes vipBlink-{{ section.id }} {

  0% {
    opacity: 1;
    transform: scale(1);
  }

  50% {
    opacity: 0.35;
    transform: scale(1.04);
  }

  100% {
    opacity: 1;
    transform: scale(1);
  }

}


#vip-deal-{{ section.id }} .vip-buy-button {

  transition:
    transform 0.2s ease,
    opacity 0.2s ease;

}


#vip-deal-{{ section.id }} .vip-buy-button:hover {

  transform: translateY(-2px);

  opacity: 0.9;

}

</style>


<script>
(function () {

  function initVipTimer() {

    const section =
      document.querySelector(
        '#vip-deal-{{ section.id }}'
      );

    if (!section) return;


    const timer =
      section.querySelector(
        '.vip-countdown'
      );

    if (!timer) return;


    const endDateValue =
      timer.getAttribute('data-end-date');

    if (!endDateValue) return;


    const endDate =
      new Date(endDateValue).getTime();


    if (isNaN(endDate)) return;


    const daysElement =
      timer.querySelector('.vip-days');

    const hoursElement =
      timer.querySelector('.vip-hours');

    const minutesElement =
      timer.querySelector('.vip-minutes');

    const secondsElement =
      timer.querySelector('.vip-seconds');


    function pad(number) {
      return String(number).padStart(2, '0');
    }


    function updateTimer() {

      const now =
        new Date().getTime();

      const distance =
        endDate - now;


      if (distance <= 0) {

        daysElement.textContent = '00';
        hoursElement.textContent = '00';
        minutesElement.textContent = '00';
        secondsElement.textContent = '00';

        return;

      }


      const days =
        Math.floor(
          distance /
          (1000 * 60 * 60 * 24)
        );


      const hours =
        Math.floor(
          (
            distance %
            (1000 * 60 * 60 * 24)
          ) /
          (1000 * 60 * 60)
        );


      const minutes =
        Math.floor(
          (
            distance %
            (1000 * 60 * 60)
          ) /
          (1000 * 60)
        );


      const seconds =
        Math.floor(
          (
            distance %
            (1000 * 60)
          ) /
          1000
        );


      daysElement.textContent =
        pad(days);

      hoursElement.textContent =
        pad(hours);

      minutesElement.textContent =
        pad(minutes);

      secondsElement.textContent =
        pad(seconds);

    }


    updateTimer();

    setInterval(updateTimer, 1000);

  }


  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initVipTimer
    );

  } else {

    initVipTimer();

  }


  document.addEventListener(
    'shopify:section:load',
    initVipTimer
  );

})();
</script>


