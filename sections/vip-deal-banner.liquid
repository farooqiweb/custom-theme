    width: 100%;
    max-width: {{ section.settings.desktop_content_width }}px;

    display: flex;
    flex-direction: column;

    {% case section.settings.desktop_text_alignment %}

      {% when 'left' %}
        align-items: flex-start;
        text-align: left;

      {% when 'right' %}
        align-items: flex-end;
        text-align: right;

      {% else %}
        align-items: center;
        text-align: center;

    {% endcase %}

  }


  #vip-deal-{{ section.id }} .vip-heading {

    margin: 0 0 {{ section.settings.desktop_heading_space }}px;

    color: {{ section.settings.heading_color }};

    font-size: {{ section.settings.desktop_heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};

    line-height: 1.1;

  }


  #vip-deal-{{ section.id }} .vip-deal-badge {

    width: fit-content;

    background: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};

    font-size: {{ section.settings.desktop_badge_size }}px;

    font-weight: 700;

    padding:
      {{ section.settings.desktop_badge_vertical }}px
      {{ section.settings.desktop_badge_horizontal }}px;

    border-radius: {{ section.settings.badge_radius }}px;

    margin-bottom: {{ section.settings.desktop_badge_space }}px;

    {% if section.settings.enable_blink %}
      animation:
        vipBlink-{{ section.id }}
        {{ section.settings.blink_speed }}s
        infinite;
    {% endif %}

  }


  #vip-deal-{{ section.id }} .vip-description {

    color: {{ section.settings.description_color }};

    font-size: {{ section.settings.desktop_description_size }}px;

    line-height: 1.4;

    margin-bottom: {{ section.settings.desktop_description_space }}px;

  }


  #vip-deal-{{ section.id }} .vip-description p {
    margin: 0;
  }


  #vip-deal-{{ section.id }} .vip-countdown {

    display: flex;
    align-items: center;

    gap: {{ section.settings.desktop_timer_gap }}px;

    margin-bottom: {{ section.settings.desktop_timer_space }}px;

  }


  #vip-deal-{{ section.id }} .vip-time-box {

    width: {{ section.settings.desktop_timer_width }}px;
    height: {{ section.settings.desktop_timer_height }}px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    background: {{ section.settings.timer_bg }};
    color: {{ section.settings.timer_text_color }};

    border-radius: {{ section.settings.timer_radius }}px;

  }


  #vip-deal-{{ section.id }} .vip-time-box span {

    font-size: {{ section.settings.desktop_timer_number_size }}px;

    font-weight: 800;

    line-height: 1;

  }


  #vip-deal-{{ section.id }} .vip-time-box small {

    font-size: {{ section.settings.desktop_timer_label_size }}px;

    margin-top: 2px;

    line-height: 1;

  }


  #vip-deal-{{ section.id }} .vip-separator {

    color: {{ section.settings.timer_separator_color }};

    font-size: {{ section.settings.desktop_separator_size }}px;

    font-weight: 800;

  }


  #vip-deal-{{ section.id }} .vip-buy-button {

    display: inline-flex;

    justify-content: center;
    align-items: center;

    min-width: {{ section.settings.desktop_button_width }}px;

    padding:
      {{ section.settings.desktop_button_vertical }}px
      {{ section.settings.desktop_button_horizontal }}px;

    background: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};

    text-decoration: none;

    font-size: {{ section.settings.desktop_button_size }}px;

    font-weight: {{ section.settings.button_weight }};

    border-radius: {{ section.settings.button_radius }}px;

    box-sizing: border-box;

  }

}


/* ======================================================
   MOBILE
====================================================== */

