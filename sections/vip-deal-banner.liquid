    margin-bottom:
      {{ section.settings.mobile_timer_space }}px;

  }


  #vip-deal-{{ section.id }} .vip-time-box {

    width:
      {{ section.settings.mobile_timer_width }}px;

    height:
      {{ section.settings.mobile_timer_height }}px;

    display: flex;
    flex-direction: column;

    align-items: center;
    justify-content: center;

    background:
      {{ section.settings.timer_bg }};

    color:
      {{ section.settings.timer_text_color }};

    border-radius:
      {{ section.settings.timer_radius }}px;

  }


  #vip-deal-{{ section.id }} .vip-time-box span {

    font-size:
      {{ section.settings.mobile_timer_number_size }}px;

    font-weight: 800;

    line-height: 1;

  }


  #vip-deal-{{ section.id }} .vip-time-box small {

    font-size:
