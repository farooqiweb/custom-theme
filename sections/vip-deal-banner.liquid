        text-align: left;

      {% when 'right' %}
        align-items: flex-end;
        text-align: right;

      {% else %}
        align-items: center;
        text-align: center;

    {% endcase %}

  }


  #vip-deal-{{ section.id }} .vip-heading {

    margin:
      0
      0
      {{ section.settings.mobile_heading_space }}px;

    color: {{ section.settings.heading_color }};

    font-size:
      {{ section.settings.mobile_heading_size }}px;

    font-weight:
      {{ section.settings.heading_weight }};

    line-height: 1.1;

  }


  #vip-deal-{{ section.id }} .vip-deal-badge {

    width: fit-content;

    background:
      {{ section.settings.badge_bg }};

    color:
      {{ section.settings.badge_text_color }};

    font-size:
      {{ section.settings.mobile_badge_size }}px;

    font-weight: 700;

    padding:
      {{ section.settings.mobile_badge_vertical }}px
      {{ section.settings.mobile_badge_horizontal }}px;

    border-radius:
      {{ section.settings.badge_radius }}px;

    margin-bottom:
      {{ section.settings.mobile_badge_space }}px;

    {% if section.settings.enable_blink %}

