{{ 'utility-kitchen.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<nav class="uk-switch color-{{ section.settings.color_scheme }} gradient" aria-label="Shop categories">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <p class="uk-switch__title">{{ section.settings.title | escape }}</p>
    {%- endif -%}
    <div class="uk-switch__links">
      <a href="{{ routes.collections_url }}/kitchen-accessories">Kitchen accessories</a>
      <a href="{{ routes.collections_url }}/home-gadgets">Home gadgets</a>
      <a href="{{ routes.all_products_collection_url }}">Bestsellers</a>
    </div>
  </div>
</nav>

{% schema %}
{
  "name": "Category switch",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 8
    }
  ],
  "presets": [{ "name": "Category switch" }]
}
{% endschema %}
