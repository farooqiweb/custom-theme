                  -%}
                {%- when 'variant_picker' -%}
                  {% render 'product-variant-picker',
                    product: product,
                    block: block,
                    product_form_id: product_form_id
                  %}
                {%- when 'buy_buttons' -%}
                  <style>
                    .product-buy-buttons-custom-{{ block.id }} .product-form__buttons {
                      max-width: 100% !important;
