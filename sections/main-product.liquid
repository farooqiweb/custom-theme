                      outline: 0 !important;
                      box-shadow: none !important;
                      filter: none !important;
                      -webkit-filter: none !important;
                    }

                    /* BUY NOW BUTTON BASE */
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded {
                      min-height: {{ block.settings.buy_h_d }}px !important;
                      height: {{ block.settings.buy_h_d }}px !important;
                      margin: 0 !important;
                      padding: 0 18px !important;
                      font-size: {{ block.settings.buy_size_d }}px !important;
                      font-weight: {{ block.settings.buy_weight }} !important;
                      letter-spacing: {{ block.settings.button_letter }}px !important;
                      text-transform: {{ block.settings.button_transform }} !important;
                      line-height: 1 !important;
                      background: {{ block.settings.buy_bg }} !important;
                      background-image: none !important;
                      color: {{ block.settings.buy_text }} !important;
                      border: {{ block.settings.buy_border_w }}px solid {{ block.settings.buy_border }} !important;
                      border-radius: {{ block.settings.buy_radius }}px !important;
                      outline: 0 !important;
                      box-shadow: none !important;
                      -webkit-box-shadow: none !important;
                      filter: none !important;
                      -webkit-filter: none !important;
                      text-shadow: none !important;
                      transform: none !important;
                      -webkit-appearance: none !important;
                      appearance: none !important;
                    }

                    /* Completely remove Dawn/theme pseudo-element border + shadow layers */
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button::before,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button::after,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded::before,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded::after {
                      content: none !important;
                      display: none !important;
                      border: 0 !important;
                      outline: 0 !important;
                      box-shadow: none !important;
                      -webkit-box-shadow: none !important;
                      background: transparent !important;
                      filter: none !important;
                      transform: none !important;
                    }

                    /* Keep every state clean - no yellow/gold hover, focus or active layer */
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button:hover,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button:focus,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button:focus-visible,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button:active,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded:hover,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded:focus,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded:focus-visible,
                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded:active {
                      outline: 0 !important;
                      box-shadow: none !important;
                      -webkit-box-shadow: none !important;
                      filter: none !important;
                      transform: none !important;
                    }

                    .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button__button--unbranded:hover:not([disabled]) {
                      background: {{ block.settings.buy_hover_bg }} !important;
                      background-image: none !important;
                      color: {{ block.settings.buy_hover_text }} !important;
                      border-color: {{ block.settings.buy_hover_bg }} !important;
                      box-shadow: none !important;
                    }

                    {% if block.settings.button_align_d == 'center' %}
                      .product-buy-buttons-custom-{{ block.id }} .product-form__submit,
                      .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button {
                        margin-left: auto !important;
                        margin-right: auto !important;
                      }
                    {% elsif block.settings.button_align_d == 'right' %}
                      .product-buy-buttons-custom-{{ block.id }} .product-form__submit,
                      .product-buy-buttons-custom-{{ block.id }} .shopify-payment-button {
                        margin-left: auto !important;
                        margin-right: 0 !important;
