{{ 'utility-kitchen.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="uk-spotlight color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank -%}
      <h2 class="uk-spotlight__title title {{ section.settings.heading_size }}">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    <div class="uk-spotlight__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          assign tile_url = block.settings.link
          if tile_url == blank and tile_collection != empty
            assign tile_url = tile_collection.url
          endif
          if tile_url == blank
            assign tile_url = routes.collections_url
          endif
          assign tile_image = block.settings.image
          if tile_image == blank and tile_collection != empty and tile_collection.featured_image
            assign tile_image = tile_collection.featured_image
          endif
          assign tile_heading = block.settings.heading
          if tile_heading == blank and tile_collection != empty
            assign tile_heading = tile_collection.title
          endif
          assign tile_fallback = 'uk-cat-kitchen.jpg'
          if block.settings.accent == 'enamel'
            assign tile_fallback = 'uk-cat-gadgets.jpg'
          endif
        -%}
        <a
          class="uk-spotlight__tile uk-spotlight__tile--{{ block.settings.accent }}"
          href="{{ tile_url }}"
          {{ block.shopify_attributes }}
        >
          {%- if tile_image != blank -%}
            {{
              tile_image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1400',
                sizes: '(min-width: 750px) 46vw, 100vw',
                alt: tile_heading
            }}
          {%- else -%}
            <img
              src="{{ tile_fallback | asset_url }}"
              alt="{{ tile_heading | escape }}"
              width="800"
              height="800"
              loading="lazy"
            >
          {%- endif -%}
          <span class="uk-spotlight__copy">
            {%- if block.settings.kicker != blank -%}
              <span class="uk-spotlight__kicker">{{ block.settings.kicker | escape }}</span>
            {%- endif -%}
            {%- if tile_heading != blank -%}
              <h3>{{ tile_heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="uk-spotlight__cta">{{ block.settings.button_label | escape }}</span>
            {%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Category spotlight",
  "tag": "section",
  "class": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "limit": 2,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "kicker",
          "label": "Small label",
          "default": "Shop"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Kitchen accessories"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button",
          "default": "Shop now"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Overlay color",
          "options": [
            { "value": "chili", "label": "Chili" },
            { "value": "enamel", "label": "Enamel" }
          ],
          "default": "chili"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category spotlight",
      "blocks": [
        { "type": "tile" },
        { "type": "tile" }
      ]
    }
  ]
}
{% endschema %}
