<section class="bd-announcement-{{ section.id }}">

<div class="bd-announcement-wrapper-{{ section.id }}">

{% for block in section.blocks %}

<div class="bd-announcement-item-{{ section.id }} 
{% if forloop.first %}active{% endif %}"
{{ block.shopify_attributes }}>


<div class="bd-announcement-content-{{ section.id }}">


{% if block.settings.icon != blank %}
<span class="bd-icon-{{ section.id }}">
{{ block.settings.icon }}
</span>
{% endif %}


<span class="bd-text-{{ section.id }}">
{{ block.settings.message }}
</span>



{% if block.settings.show_button %}

<a 
href="{{ block.settings.button_link }}"
class="bd-button-{{ section.id }}">

{{ block.settings.button_label }}

</a>

{% endif %}


</div>


</div>

{% endfor %}

</div>

</section>



<style>


.bd-announcement-{{ section.id }}{

width:100%;
background:{{ section.settings.bg_color }};
overflow:hidden;

}



.bd-announcement-wrapper-{{ section.id }}{

position:relative;
height:45px;
display:flex;
align-items:center;
justify-content:center;

}



.bd-announcement-item-{{ section.id }}{

position:absolute;

width:100%;

opacity:0;

transform:translateY(100%);

transition:
transform .6s ease,
opacity .6s ease;

display:flex;
justify-content:center;
align-items:center;

}



.bd-announcement-item-{{ section.id }}.active{

opacity:1;

transform:translateY(0);

}



.bd-announcement-content-{{ section.id }}{

display:flex;

align-items:center;

justify-content:center;

gap:12px;

flex-wrap:wrap;

text-align:center;

}



.bd-icon-{{ section.id }}{

font-size:18px;

}



.bd-text-{{ section.id }}{

color:{{ section.settings.text_color }};

font-size:{{ section.settings.text_size }}px;

font-weight:{{ section.settings.font_weight }};

}



.bd-button-{{ section.id }}{

background:{{ section.settings.button_bg }};

color:{{ section.settings.button_text }};

padding:6px 18px;

border-radius:25px;

text-decoration:none;

font-size:14px;

}





@media(max-width:768px){


.bd-announcement-wrapper-{{ section.id }}{

height:42px;

}



.bd-text-{{ section.id }}{

font-size:{{ section.settings.mobile_text_size }}px;

}



.bd-announcement-content-{{ section.id }}{

gap:8px;

}



.bd-button-{{ section.id }}{

font-size:12px;

padding:5px 14px;

}


}



</style>




<script>


document.addEventListener("DOMContentLoaded",function(){


let announcements = document.querySelectorAll(
".bd-announcement-item-{{ section.id }}"
);


let current = 0;



{% if section.settings.auto_rotate %}


setInterval(function(){


announcements[current].classList.remove("active");


current++;


if(current >= announcements.length){

current = 0;

}


announcements[current].classList.add("active");



}, {{ section.settings.speed }}000);


{% endif %}



});


</script>




{% schema %}

{

"name":"BD Announcement Bar",


"settings":[


{
"type":"color",
"id":"bg_color",
"label":"Background Color",
"default":"#132b20"
},


{
"type":"color",
"id":"text_color",
"label":"Text Color",
"default":"#FFFFFF"
},


{
"type":"range",
"id":"text_size",
"label":"Desktop Text Size",
"min":12,
"max":25,
"step":1,
"default":16
},


{
"type":"range",
"id":"mobile_text_size",
"label":"Mobile Text Size",
"min":10,
"max":20,
"step":1,
"default":14
},


{
"type":"select",
"id":"font_weight",
"label":"Font Weight",
"default":"500",

"options":[

{
"value":"400",
"label":"Normal"
},

{
"value":"500",
"label":"Medium"
},

{
"value":"700",
"label":"Bold"
}

]

},


{
"type":"checkbox",
"id":"auto_rotate",
"label":"Enable Auto Rotate",
"default":true
},


{
"type":"range",
"id":"speed",
"label":"Slide Change Speed",
"min":3,
"max":15,
"step":1,
"default":5
},


{
"type":"color",
"id":"button_bg",
"label":"Button Background",
"default":"#e85a2a"
},


{
"type":"color",
"id":"button_text",
"label":"Button Text Color",
"default":"#132b20"
}


],



"blocks":[


{

"type":"announcement",

"name":"Announcement",


"settings":[


{
"type":"text",
"id":"icon",
"label":"Icon",
"default":"🔥"
},


{
"type":"text",
"id":"message",
"label":"Message",
"default":"Free Shipping Across Pakistan"
},


{
"type":"checkbox",
"id":"show_button",
"label":"Show Button",
"default":false
},


{
"type":"text",
"id":"button_label",
"label":"Button Text",
"default":"Shop Now"
},


{
"type":"url",
"id":"button_link",
"label":"Button Link"
}


]

}


],



"presets":[

{

"name":"BD Announcement Bar",

"blocks":[

{
"type":"announcement"
},

{
"type":"announcement"
},

{
"type":"announcement"
}

]

}

]

}

{% endschema %}