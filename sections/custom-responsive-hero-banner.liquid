<section class="responsive-hero-slider-{{ section.id }}">

<div class="hero-slider-wrapper-{{ section.id }}">


{% for block in section.blocks %}

<div class="hero-slide-{{ section.id }} {% if forloop.first %}active{% endif %}"
{{ block.shopify_attributes }}>


<!-- Desktop Image -->

<div class="hero-desktop-image-{{ section.id }}">

{% if block.settings.desktop_image != blank %}

<img 
src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
alt="{{ block.settings.heading | escape }}"
loading="lazy"
>

{% endif %}

</div>



<!-- Mobile Image -->

<div class="hero-mobile-image-{{ section.id }}">

{% if block.settings.mobile_image != blank %}

<img 
src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
alt="{{ block.settings.heading | escape }}"
loading="lazy"
>

{% else %}

<img 
src="{{ block.settings.desktop_image | image_url: width: 1200 }}"
alt="{{ block.settings.heading | escape }}"
loading="lazy"
>

{% endif %}

</div>




<div class="hero-overlay-{{ section.id }}"
style="
opacity:{{ block.settings.overlay | divided_by:100.0 }};
">
</div>




<div class="hero-content-{{ section.id }}">

{% if block.settings.heading != blank %}

<h1
style="
color:{{ block.settings.text_color }};
font-size:{{ block.settings.desktop_heading_size }}px;
">

{{ block.settings.heading }}

</h1>

{% endif %}




{% if block.settings.description != blank %}

<p
style="
color:{{ block.settings.text_color }};
">

{{ block.settings.description }}

</p>

{% endif %}




{% if block.settings.button_text != blank %}

<a 
href="{{ block.settings.button_link }}"
class="hero-button-{{ section.id }}"
style="
background:{{ block.settings.button_color }};
color:{{ block.settings.button_text_color }};
">

{{ block.settings.button_text }}

</a>

{% endif %}



</div>



</div>


{% endfor %}



<!-- Navigation -->

{% if section.blocks.size > 1 %}

<button class="hero-prev-{{ section.id }}">
‹
</button>


<button class="hero-next-{{ section.id }}">
›
</button>



<div class="hero-dots-{{ section.id }}">

{% for block in section.blocks %}

<span 
class="hero-dot-{{ section.id }} {% if forloop.first %}active{% endif %}"
data-index="{{ forloop.index0 }}">
</span>

{% endfor %}

</div>

{% endif %}



</div>

</section>





<style>


.responsive-hero-slider-{{ section.id }}{

width:100%;
overflow:hidden;

}


.hero-slider-wrapper-{{ section.id }}{

position:relative;

}



.hero-slide-{{ section.id }}{

display:none;
position:relative;

}



.hero-slide-{{ section.id }}.active{

display:block;

}



.hero-desktop-image-{{ section.id }} img,
.hero-mobile-image-{{ section.id }} img{

width:100%;
display:block;
object-fit:cover;

}




.hero-mobile-image-{{ section.id }}{

display:none;

}




.hero-overlay-{{ section.id }}{

position:absolute;
inset:0;
background:#000;

}



.hero-content-{{ section.id }}{

position:absolute;
z-index:2;

top:50%;
left:50%;

transform:translate(-50%,-50%);

text-align:center;

width:90%;
max-width:700px;

}




.hero-content-{{ section.id }} h1{

margin-bottom:15px;

}



.hero-content-{{ section.id }} p{

font-size:18px;

}




.hero-button-{{ section.id }}{

display:inline-block;

padding:12px 30px;

border-radius:30px;

text-decoration:none;

margin-top:20px;

}




.hero-prev-{{ section.id }},
.hero-next-{{ section.id }}{

position:absolute;

top:50%;

transform:translateY(-50%);

z-index:5;

width:45px;

height:45px;

border-radius:50%;

border:none;

background:rgba(0,0,0,.5);

color:white;

font-size:30px;

cursor:pointer;

}



.hero-prev-{{ section.id }}{

left:20px;

}



.hero-next-{{ section.id }}{

right:20px;

}




.hero-dots-{{ section.id }}{

position:absolute;

bottom:20px;

left:50%;

transform:translateX(-50%);

display:flex;

gap:10px;

z-index:5;

}



.hero-dot-{{ section.id }}{

width:10px;

height:10px;

background:white;

border-radius:50%;

opacity:.5;

cursor:pointer;

}



.hero-dot-{{ section.id }}.active{

opacity:1;

}





@media(max-width:749px){


.hero-desktop-image-{{ section.id }}{

display:none;

}



.hero-mobile-image-{{ section.id }}{

display:block;

}



.hero-content-{{ section.id }} h1{

font-size:{{ block.settings.mobile_heading_size }}px !important;

}



.hero-content-{{ section.id }} p{

font-size:15px;

}



.hero-button-{{ section.id }}{

padding:10px 20px;

font-size:14px;

}



.hero-prev-{{ section.id }},
.hero-next-{{ section.id }}{

width:35px;

height:35px;

font-size:22px;

}


}


</style>
