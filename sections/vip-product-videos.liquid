{% liquid

  assign show_vip_videos = false

  if request.page_type == 'product'

    if section.settings.products == blank

      assign show_vip_videos = true

    else

      for selected_product in section.settings.products

        if selected_product.handle == product.handle

          assign show_vip_videos = true

          break

        endif

      endfor

    endif

  endif

%}

{% if show_vip_videos and section.blocks.size > 0 %}

<section

  id="VipProductVideos-{{ section.id }}"

  class="vip-product-videos"

>

  <div class="vip-product-videos__container page-width">

    {% if section.settings.heading != blank or section.settings.subheading != blank %}

      <div class="vip-product-videos__header">

        {% if section.settings.heading != blank %}

          <h2 class="vip-product-videos__heading">

            {{ section.settings.heading }}

          </h2>

        {% endif %}

        {% if section.settings.subheading != blank %}

          <div class="vip-product-videos__subheading">

            {{ section.settings.subheading }}

          </div>

        {% endif %}

      </div>

    {% endif %}

    <div class="vip-product-videos__tabs">

      {% for block in section.blocks %}

        {% liquid

          assign video_title = block.settings.title

          assign source_type = block.settings.source_type

          assign external_id = ''

          assign external_type = ''

          assign video_src = ''

          assign poster_src = ''

          if video_title == blank

            assign video_title = 'Product Video'

          endif

          if source_type == 'external'

            if block.settings.external_video != blank

              assign external_id = block.settings.external_video.id

              assign external_type = block.settings.external_video.type

              if external_type == 'youtube'

                assign poster_src = 'https://img.youtube.com/vi/' | append: external_id | append: '/hqdefault.jpg'

              endif

            endif

          endif

          if source_type == 'shopify'

            if block.settings.shopify_video != blank

              if block.settings.shopify_video.preview_image != blank

                assign poster_src = block.settings.shopify_video.preview_image | image_url: width: 600

              endif

              for video_source in block.settings.shopify_video.sources

                if video_source.format == 'mp4'

                  assign video_src = video_source.url

                  break

                endif

              endfor

            endif

          endif

        %}

        <button

          type="button"

          class="vip-product-videos__tab"

          data-vip-video-trigger

          data-video-title="{{ video_title | escape }}"

          data-source-type="{{ source_type }}"

          data-external-id="{{ external_id }}"

          data-external-type="{{ external_type }}"

          data-video-src="{{ video_src }}"

          data-poster-src="{{ poster_src }}"

          aria-label="Play {{ video_title | escape }}"

          {{ block.shopify_attributes }}

        >

          <div class="vip-product-videos__card">

            <div class="vip-product-videos__thumbnail">
              {% if source_type == 'shopify' and video_src != blank %}
                <video class="vip-product-videos__inline-video" autoplay muted loop playsinline webkit-playsinline preload="metadata" aria-hidden="true" tabindex="-1" {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}>
                  <source src="{{ video_src }}" type="video/mp4">
                </video>
              {% elsif source_type == 'external' and external_id != blank %}
                {% if external_type == 'youtube' %}
                  <iframe class="vip-product-videos__inline-video" title="{{ video_title | escape }} preview" src="https://www.youtube-nocookie.com/embed/{{ external_id }}?autoplay=1&mute=1&loop=1&playlist={{ external_id }}&controls=0&playsinline=1&rel=0&modestbranding=1" allow="autoplay; encrypted-media; picture-in-picture" loading="eager" tabindex="-1" aria-hidden="true"></iframe>
                {% elsif external_type == 'vimeo' %}
                  <iframe class="vip-product-videos__inline-video" title="{{ video_title | escape }} preview" src="https://player.vimeo.com/video/{{ external_id }}?background=1&autoplay=1&muted=1&loop=1&autopause=0" allow="autoplay; fullscreen; picture-in-picture" loading="eager" tabindex="-1" aria-hidden="true"></iframe>
                {% endif %}
              {% elsif poster_src != blank %}
                <img src="{{ poster_src }}" alt="{{ video_title | escape }}" width="300" height="533" loading="lazy">
              {% else %}
                <div class="vip-product-videos__placeholder"><span>VIDEO</span></div>
              {% endif %}
              <span class="vip-product-videos__play" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M8 5.5v13l10-6.5-10-6.5z" fill="currentColor"></path></svg>
              </span>
            </div>

            <div class="vip-product-videos__info">

              <span class="vip-product-videos__number">

                {% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}

              </span>

              <span class="vip-product-videos__title">

                {{ video_title }}

              </span>

            </div>

          </div>

        </button>

      {% endfor %}

    </div>

  </div>

  <div

    class="vip-product-videos__modal"

    data-vip-video-modal

    aria-hidden="true"

  >

    <button

      type="button"

      class="vip-product-videos__backdrop"

      data-vip-video-close

      aria-label="Close video"

    >

    </button>

    <div

      class="vip-product-videos__dialog"

      role="dialog"

      aria-modal="true"

      aria-label="Product video player"

    >

      <button

        type="button"

        class="vip-product-videos__close"

        data-vip-video-close

        aria-label="Close"

      >

        <svg

          viewBox="0 0 24 24"

          aria-hidden="true"

        >

          <path

            d="M18.3 5.7 12 12l6.3 6.3-1.4 1.4-6.3-6.3-6.3 6.3-1.4-1.4L9.2 12 2.9 5.7l1.4-1.4 6.3 6.3 6.3-6.3 1.4 1.4z"

            fill="currentColor"

          >

          </path>

        </svg>

      </button>

      <div class="vip-product-videos__modal-card">

        <div class="vip-product-videos__modal-header">

          <span class="vip-product-videos__brand">

            Bestdeal.pk

          </span>

          <h3

            class="vip-product-videos__modal-title"

            data-vip-video-title

          >

            Product Video

          </h3>

        </div>

        <div

          class="vip-product-videos__player"

          data-vip-video-player

        >

        </div>

      </div>

    </div>

  </div>

</section>

