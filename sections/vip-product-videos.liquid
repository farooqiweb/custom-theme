  #VipProductVideos-{{ section.id }} .vip-product-videos__tab:hover .vip-product-videos__play,
  #VipProductVideos-{{ section.id }} .vip-product-videos__tab:focus-visible .vip-product-videos__play {
    opacity: 1;
  }
</style>

<script>

(function () {

  const section =

    document.getElementById(

      'VipProductVideos-{{ section.id }}'

    );

  if (!section) {

    return;

  }

  const modal =

    section.querySelector(

      '[data-vip-video-modal]'

    );

  const player =

    section.querySelector(

      '[data-vip-video-player]'

    );

  const modalTitle =

    section.querySelector(

      '[data-vip-video-title]'

    );

  const triggers =

    section.querySelectorAll(

      '[data-vip-video-trigger]'

    );

  const closeButtons =

    section.querySelectorAll(

      '[data-vip-video-close]'

    );

  if (

    !modal ||

    !player ||

    !modalTitle

  ) {

    return;

  }

  function startInlineVideos() {
    section.querySelectorAll('video.vip-product-videos__inline-video').forEach(function (video) {
      video.muted = true;
      const attempt = video.play();
      if (attempt && typeof attempt.catch === 'function') attempt.catch(function () {});
    });
  }
  startInlineVideos();
  document.addEventListener('visibilitychange', function () {
    if (!document.hidden) startInlineVideos();
  });

  function clearPlayer() {

    player.innerHTML = '';

  }

  function openModal(button) {

    const title =

      button.dataset.videoTitle ||

      'Product Video';

    const sourceType =

      button.dataset.sourceType;

    const externalId =

      button.dataset.externalId;

    const externalType =

      button.dataset.externalType;

    const videoSrc =

      button.dataset.videoSrc;

    const posterSrc =

      button.dataset.posterSrc;

    modalTitle.textContent = title;

    clearPlayer();

    /*

    ---------------------------

    YOUTUBE / VIMEO

    ---------------------------

    */

    if (

      sourceType === 'external' &&

      externalId

    ) {

      const iframe =

        document.createElement(

          'iframe'

        );

      if (

        externalType === 'youtube'

      ) {

        iframe.src =

          'https://www.youtube.com/embed/' +

          externalId +

          '?autoplay=1&mute=1&rel=0&playsinline=1';

      }

      else if (

        externalType === 'vimeo'

      ) {

        iframe.src =

          'https://player.vimeo.com/video/' +

          externalId +

          '?autoplay=1&muted=1';

      }

      iframe.title = title;

      iframe.allow =

        'autoplay; encrypted-media; picture-in-picture; fullscreen';

      iframe.allowFullscreen = true;

      player.appendChild(

        iframe

      );

    }

    /*

    ---------------------------

    SHOPIFY VIDEO

    ---------------------------

    */

    else if (

      sourceType === 'shopify' &&

      videoSrc

    ) {

      const video =

        document.createElement(

          'video'

        );

      video.src =

        videoSrc;

      video.controls =

        true;

      video.autoplay =

        true;

      video.muted = true;

      video.playsInline =

        true;

      video.preload =

        'metadata';

      if (posterSrc) {

        video.poster =

          posterSrc;

      }

      player.appendChild(

        video

      );

      const playPromise =

        video.play();

      if (

        playPromise !== undefined

      ) {

        playPromise.catch(

          function () {}

        );

      }

    }

    modal.classList.add(

      'is-open'

    );

    modal.setAttribute(

      'aria-hidden',

      'false'

    );

    document.body.classList.add(

      'vip-product-video-open'

    );

  }

  function closeModal() {

    modal.classList.remove(

      'is-open'

    );

    modal.setAttribute(

      'aria-hidden',

      'true'

    );

    document.body.classList.remove(

      'vip-product-video-open'

    );

    clearPlayer();

  }

  triggers.forEach(

    function (trigger) {

      trigger.addEventListener(

        'click',

        function () {

          openModal(

            trigger

          );

        }

      );

    }

  );

  closeButtons.forEach(

    function (closeButton) {

      closeButton.addEventListener(

        'click',

        closeModal

      );

    }

  );

  document.addEventListener(

    'keydown',

    function (event) {

      if (

        event.key === 'Escape' &&

        modal.classList.contains(

          'is-open'

        )

      ) {

        closeModal();

      }

    }

  );

})();

</script>

{% endif %}

