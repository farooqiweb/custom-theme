<div class="template-404 page-width page-margin center">
  <p>
    {{ 'templates.404.subtext' | t }}
  </p>
  <h1 class="title">
    {{ 'templates.404.title' | t }}
  </h1>
  <a href="{{ routes.all_products_collection_url }}" class="button">
    {{ 'general.continue_shopping' | t }}
  </a>
  <div class="template-404__links">
    <a href="{{ routes.collections_url }}/kitchen-accessories" class="button button--secondary">Kitchen accessories</a>
    <a href="{{ routes.collections_url }}/home-gadgets" class="button button--secondary">Home gadgets</a>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-404.name"
}
{% endschema %}
