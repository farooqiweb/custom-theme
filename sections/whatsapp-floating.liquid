{% assign wa_phone = section.settings.phone | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' %}
{% assign wa_message = section.settings.message | url_encode %}

{% if section.settings.enable_button and wa_phone != blank %}

<a
  href="https://wa.me/{{ wa_phone }}?text={{ wa_message }}"
  class="bestdeal-whatsapp-{{ section.id }}"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Chat on WhatsApp"
>
  <svg
    viewBox="0 0 32 32"
    aria-hidden="true"
    focusable="false"
  >
    <path
      fill="currentColor"
      d="M16 3C8.83 3 3 8.61 3 15.5c0 2.42.72 4.77 2.08 6.77L3 29l7-2.02A13.35 13.35 0 0 0 16 28c7.17 0 13-5.61 13-12.5S23.17 3 16 3zm0 22.72c-1.9 0-3.76-.5-5.38-1.45l-.39-.23-4.15 1.2 1.22-4.02-.25-.4a10.04 10.04 0 0 1-1.6-5.32C5.45 9.86 10.18 5.28 16 5.28S26.55 9.86 26.55 15.5 21.82 25.72 16 25.72zm5.78-7.65c-.32-.16-1.88-.9-2.17-1-.29-.1-.5-.16-.71.16-.21.31-.82 1-.99 1.2-.18.21-.36.23-.68.08-.31-.16-1.32-.47-2.52-1.51-.93-.81-1.56-1.8-1.74-2.11-.18-.31-.02-.48.14-.64.14-.14.31-.36.47-.54.16-.18.21-.31.31-.52.1-.21.05-.39-.03-.54-.08-.16-.71-1.66-.97-2.27-.25-.6-.51-.52-.71-.53h-.61c-.21 0-.55.08-.84.39-.29.31-1.1 1.04-1.1 2.54 0 1.5 1.13 2.95 1.29 3.16.16.21 2.22 3.28 5.38 4.6.75.32 1.34.51 1.8.65.76.23 1.44.2 1.99.12.61-.09 1.88-.74 2.14-1.46.26-.73.26-1.35.18-1.47-.08-.13-.29-.21-.61-.37z"
    />
  </svg>
</a>

<style>
  .bestdeal-whatsapp-{{ section.id }} {
    position: fixed;
    z-index: 999999;
    top: {{ section.settings.desktop_position }}%;

    width: {{ section.settings.desktop_size }}px;
    height: {{ section.settings.desktop_size }}px;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 0;
    margin: 0;

    background-color: {{ section.settings.background_color }};
    color: {{ section.settings.icon_color }};

    border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
    border-radius: 50%;

    text-decoration: none;
    box-sizing: border-box;

    transform: translateY(-50%);

    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;

    {% if section.settings.side == 'right' %}
      right: {{ section.settings.desktop_spacing }}px;
    {% else %}
      left: {{ section.settings.desktop_spacing }}px;
    {% endif %}

    {% if section.settings.enable_animation %}
      animation: bestdealWaPulse 2s ease-in-out infinite;
    {% endif %}
  }

  .bestdeal-whatsapp-{{ section.id }} svg {
    width: {{ section.settings.desktop_icon_size }}px;
    height: {{ section.settings.desktop_icon_size }}px;
    display: block;
  }

  .bestdeal-whatsapp-{{ section.id }}:hover {
    transform: translateY(-50%) scale(1.08);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
  }

  @keyframes bestdealWaPulse {
    0%,
    100% {
      box-shadow:
        0 4px 14px rgba(0, 0, 0, 0.22),
        0 0 0 0 rgba(37, 211, 102, 0.25);
    }

    50% {
      box-shadow:
        0 5px 17px rgba(0, 0, 0, 0.24),
        0 0 0 7px rgba(37, 211, 102, 0);
    }
  }

  @media screen and (max-width: 749px) {
    .bestdeal-whatsapp-{{ section.id }} {
      top: {{ section.settings.mobile_position }}%;

      width: {{ section.settings.mobile_size }}px;
      height: {{ section.settings.mobile_size }}px;

      {% if section.settings.side == 'right' %}
        right: {{ section.settings.mobile_spacing }}px;
        left: auto;
      {% else %}
        left: {{ section.settings.mobile_spacing }}px;
        right: auto;
      {% endif %}
    }

    .bestdeal-whatsapp-{{ section.id }} svg {
      width: {{ section.settings.mobile_icon_size }}px;
      height: {{ section.settings.mobile_icon_size }}px;
    }
  }

  {% unless section.settings.show_desktop %}
    @media screen and (min-width: 750px) {
      .bestdeal-whatsapp-{{ section.id }} {
        display: none !important;
      }
    }
  {% endunless %}

  {% unless section.settings.show_mobile %}
    @media screen and (max-width: 749px) {
      .bestdeal-whatsapp-{{ section.id }} {
        display: none !important;
      }
    }
  {% endunless %}
</style>

{% endif %}

{% schema %}
{
  "name": "WhatsApp Floating",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_button",
      "label": "Enable WhatsApp button",
      "default": true
    },
    {
      "type": "text",
      "id": "phone",
      "label": "WhatsApp number",
      "default": "923001234567",
      "info": "Example: 923001234567"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Default message",
      "default": "Hi Bestdeal.pk, I need help with my order."
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "side",
      "label": "Button side",
      "default": "right",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "range",
      "id": "desktop_position",
      "label": "Desktop vertical position",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 65
    },
    {
      "type": "range",
      "id": "mobile_position",
      "label": "Mobile vertical position",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 70
    },
    {
      "type": "range",
      "id": "desktop_spacing",
      "label": "Desktop distance from side",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "mobile_spacing",
      "label": "Mobile distance from side",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 10
    },
    {
      "type": "header",
      "content": "Desktop size"
    },
    {
      "type": "range",
      "id": "desktop_size",
      "label": "Button size",
      "min": 40,
      "max": 70,
      "step": 1,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "desktop_icon_size",
      "label": "Icon size",
      "min": 20,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 29
    },
    {
      "type": "header",
      "content": "Mobile size"
    },
    {
      "type": "range",
      "id": "mobile_size",
      "label": "Button size",
      "min": 38,
      "max": 65,
      "step": 1,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "mobile_icon_size",
      "label": "Icon size",
      "min": 18,
      "max": 38,
      "step": 1,
      "unit": "px",
      "default": 26
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Button color",
      "default": "#25D366"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 2
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable pulse animation",
      "default": true
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_desktop",
      "label": "Show on desktop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_mobile",
      "label": "Show on mobile",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "WhatsApp Floating"
    }
  ]
}
{% endschema %}