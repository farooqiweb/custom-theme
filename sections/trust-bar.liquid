{{ 'utility-kitchen.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="trust-bar uk-trust">
  <div class="page-width section-{{ section.id }}-padding">
    <ul class="trust-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="trust-bar__item" {{ block.shopify_attributes }}>
          <span class="trust-bar__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}
                <img src="{{ 'uk-icon-truck.png' | asset_url }}" alt="" width="96" height="96" class="uk-icon-3d" loading="lazy">
              {%- when 'return' -%}
                <img src="{{ 'uk-icon-return.png' | asset_url }}" alt="" width="96" height="96" class="uk-icon-3d" loading="lazy">
              {%- else -%}
                <img src="{{ 'uk-icon-cod.png' | asset_url }}" alt="" width="96" height="96" class="uk-icon-3d" loading="lazy">
            {%- endcase -%}
          </span>
          <span class="trust-bar__copy">
            {%- if block.settings.title != blank -%}
              <p class="trust-bar__title">{{ block.settings.title | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="trust-bar__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-5"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 28
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "box", "label": "Box" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" }
          ],
          "default": "box"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Cash on Delivery"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Pay when your order arrives"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "box",
            "title": "Cash on Delivery",
            "text": "Pay when your order arrives"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "title": "Free shipping",
            "text": "On orders across Pakistan"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "title": "Easy returns",
            "text": "Hassle-free support after delivery"
          }
        }
      ]
    }
  ]
}
{% endschema %}
