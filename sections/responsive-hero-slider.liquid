<section class="rh-slider-{{ section.id }}">

<div class="rh-wrapper-{{ section.id }}">


{% for block in section.blocks %}


<div class="rh-slide-{{ section.id }} {% if forloop.first %}active{% endif %}"
{{ block.shopify_attributes }}>


<!-- Desktop Banner Image -->

<div class="rh-desktop-image-{{ section.id }}">

{% if block.settings.desktop_image != blank %}

<img
src="{{ block.settings.desktop_image | image_url: width: 2400 }}"
alt="{{ block.settings.heading | escape }}"
loading="lazy"
>

{% endif %}

</div>




<!-- Mobile Banner Image -->

<div class="rh-mobile-image-{{ section.id }}">


{% if block.settings.mobile_image != blank %}

<img
src="{{ block.settings.mobile_image | image_url: width: 1200 }}"
alt="{{ block.settings.heading | escape }}"
loading="lazy"
>

{% else %}


<img
src="{{ block.settings.desktop_image | image_url: width:1200 }}"
alt="{{ block.settings.heading | escape }}"
loading="lazy"
>


{% endif %}


</div>





<!-- Content -->


<div class="rh-content-{{ section.id }}">



{% if block.settings.heading != blank %}


<h1 class="rh-heading-{{ section.id }}">

{{ block.settings.heading }}

</h1>


{% endif %}






{% if block.settings.description != blank %}


<p class="rh-description-{{ section.id }}">

{{ block.settings.description }}

</p>


{% endif %}







{% if block.settings.button_text != blank %}


<a

href="{{ block.settings.button_link }}"

class="rh-button-{{ section.id }}"

>

{{ block.settings.button_text }}


</a>


{% endif %}





</div>





</div>


{% endfor %}







<!-- Slider Navigation -->


{% if section.blocks.size > 1 %}


<button class="rh-prev-{{ section.id }}">

‹

</button>



<button class="rh-next-{{ section.id }}">

›

</button>






<div class="rh-dots-{{ section.id }}">



{% for block in section.blocks %}


<span

class="rh-dot-{{ section.id }} {% if forloop.first %}active{% endif %}"

data-slide="{{ forloop.index0 }}"

>

</span>


{% endfor %}



</div>




{% endif %}



</div>


</section>
<style>


.rh-slider-{{ section.id }}{

width:100%;
overflow:hidden;

}



.rh-wrapper-{{ section.id }}{

position:relative;

}




.rh-slide-{{ section.id }}{

display:none;

position:relative;

}



.rh-slide-{{ section.id }}.active{

display:block;

}





/* Images */


.rh-desktop-image-{{ section.id }} img,
.rh-mobile-image-{{ section.id }} img{

width:100%;

height:100%;

display:block;

object-fit:cover;

}





.rh-desktop-image-{{ section.id }}{

height:{{ section.settings.desktop_height }}px;

}





.rh-mobile-image-{{ section.id }}{

display:none;

height:{{ section.settings.mobile_height }}px;

}







/* Content */


.rh-content-{{ section.id }}{

position:absolute;

z-index:2;

top:50%;

left:50%;

transform:translate(-50%,-50%);

width:90%;

max-width:700px;

text-align:center;

}





.rh-heading-{{ section.id }}{

margin:0 0 15px;

color:{{ section.settings.text_color }};

font-size:{{ section.settings.desktop_heading_size }}px;

}





.rh-description-{{ section.id }}{

color:{{ section.settings.text_color }};

font-size:18px;

}





.rh-button-{{ section.id }}{


display:inline-block;

margin-top:20px;

padding:12px 30px;

border-radius:30px;

text-decoration:none;

background:{{ section.settings.button_color }};

color:{{ section.settings.button_text_color }};

}







/* Navigation */


.rh-prev-{{ section.id }},
.rh-next-{{ section.id }}{


position:absolute;

top:50%;

transform:translateY(-50%);

z-index:5;


width:45px;

height:45px;

border-radius:50%;

border:none;

background:rgba(0,0,0,.35);

color:white;

font-size:30px;

cursor:pointer;


}




.rh-prev-{{ section.id }}{

left:20px;

}



.rh-next-{{ section.id }}{

right:20px;

}





/* Dots */


.rh-dots-{{ section.id }}{


position:absolute;

bottom:20px;

left:50%;

transform:translateX(-50%);


display:flex;

gap:10px;

z-index:5;


}





.rh-dot-{{ section.id }}{


width:10px;

height:10px;

background:white;

border-radius:50%;

opacity:.5;

cursor:pointer;


}





.rh-dot-{{ section.id }}.active{

opacity:1;

}





/* Mobile */


@media(max-width:749px){



.rh-desktop-image-{{ section.id }}{

display:none;

}




.rh-mobile-image-{{ section.id }}{

display:block;

}




.rh-heading-{{ section.id }}{

font-size:{{ section.settings.mobile_heading_size }}px;

}




.rh-description-{{ section.id }}{

font-size:15px;

}




.rh-button-{{ section.id }}{

padding:10px 22px;

font-size:14px;

}




.rh-prev-{{ section.id }},
.rh-next-{{ section.id }}{


width:35px;

height:35px;

font-size:22px;


}



}

</style>





<script>


document.addEventListener("DOMContentLoaded",function(){



const slider = document.querySelector(
".rh-wrapper-{{ section.id }}"
);



if(!slider) return;





const slides = slider.querySelectorAll(
".rh-slide-{{ section.id }}"
);



const dots = slider.querySelectorAll(
".rh-dot-{{ section.id }}"
);




const nextBtn = slider.querySelector(
".rh-next-{{ section.id }}"
);




const prevBtn = slider.querySelector(
".rh-prev-{{ section.id }}"
);





let current = 0;







function changeSlide(index){



slides.forEach(function(slide){

slide.classList.remove("active");

});





dots.forEach(function(dot){

dot.classList.remove("active");

});







if(index >= slides.length){

current = 0;

}

else if(index < 0){

current = slides.length - 1;

}

else{

current = index;

}






slides[current].classList.add("active");





if(dots[current]){

dots[current].classList.add("active");

}




}







if(nextBtn){


nextBtn.addEventListener("click",function(){


changeSlide(current + 1);


});


}







if(prevBtn){


prevBtn.addEventListener("click",function(){


changeSlide(current - 1);


});


}







dots.forEach(function(dot,index){


dot.addEventListener("click",function(){


changeSlide(index);


});


});







{% if section.settings.auto_rotate %}



setInterval(function(){


changeSlide(current + 1);


},

{{ section.settings.speed }}000);



{% endif %}






});

</script>
{% schema %}

{

"name":"Responsive Hero Slider",

"settings":[


{
"type":"checkbox",
"id":"auto_rotate",
"label":"Enable Auto Rotate",
"default":true
},


{
"type":"range",
"id":"speed",
"label":"Slider Speed",
"min":3,
"max":15,
"step":1,
"default":5
},




{
"type":"range",
"id":"desktop_height",
"label":"Desktop Banner Height",
"min":300,
"max":900,
"step":50,
"default":600
},



{
"type":"range",
"id":"mobile_height",
"label":"Mobile Banner Height",
"min":250,
"max":700,
"step":25,
"default":450
},





{
"type":"range",
"id":"desktop_heading_size",
"label":"Desktop Heading Size",
"min":20,
"max":80,
"step":2,
"default":48
},




{
"type":"range",
"id":"mobile_heading_size",
"label":"Mobile Heading Size",
"min":14,
"max":50,
"step":2,
"default":26
},





{
"type":"color",
"id":"text_color",
"label":"Text Color",
"default":"#ffffff"
},




{
"type":"color",
"id":"button_color",
"label":"Button Color",
"default":"#D4AF37"
},




{
"type":"color",
"id":"button_text_color",
"label":"Button Text Color",
"default":"#24104F"
}



],







"blocks":[



{

"type":"slide",

"name":"Hero Slide",



"settings":[




{
"type":"image_picker",
"id":"desktop_image",
"label":"Desktop Banner Image"
},





{
"type":"image_picker",
"id":"mobile_image",
"label":"Mobile Banner Image"
},





{
"type":"text",
"id":"heading",
"label":"Heading",
"default":"Best Deals For You"
},





{
"type":"textarea",
"id":"description",
"label":"Description",
"default":"Discover our latest collection"
},





{
"type":"text",
"id":"button_text",
"label":"Button Text",
"default":"Shop Now"
},





{
"type":"url",
"id":"button_link",
"label":"Button Link"
}




]

}



],







"presets":[



{

"name":"Responsive Hero Slider",



"blocks":[


{
"type":"slide"
},



{
"type":"slide"
},



{
"type":"slide"
}



]

}



]



}

{% endschema %} 